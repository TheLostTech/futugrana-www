---
---
<div class="w-full h-full bg-ink text-paper relative flex flex-col items-center justify-center gap-8 p-[clamp(28px,4vw,80px)] overflow-hidden">
  <span
    data-hedge-tl
    style="opacity: 0; transform: translateX(-60vw);"
    class="absolute top-[6%] left-[5%] font-display font-medium text-[clamp(44px,6vw,92px)] tracking-[-0.02em] text-paper leading-[0.95] z-[3] max-w-[55%] will-change-transform"
  >
    da contratti
  </span>

  <span
    data-hedge-br
    style="opacity: 0; transform: translateX(60vw);"
    class="absolute bottom-[22%] right-[5%] font-display font-medium text-[clamp(44px,6vw,92px)] tracking-[-0.02em] text-paper leading-[0.95] z-[3] max-w-[55%] text-right will-change-transform"
  >
    a lotti CFD
  </span>

  <div class="hedge-center grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-5 md:gap-6 items-stretch max-w-[920px] w-full z-[2]">
    <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 flex flex-col gap-2">
      <div class="text-[11px] uppercase tracking-[0.18em] text-paper/55 font-medium">PROP · Tradovate</div>
      <div class="text-lg font-semibold tracking-tight">long NQ</div>
      <div class="flex items-baseline gap-2 mt-1">
        <span class="text-3xl font-semibold tabular-nums tracking-tight">2</span>
        <span class="text-sm text-paper/55 font-medium">contratti</span>
      </div>
    </div>

    <div class="flex md:flex-col items-center justify-center gap-2 px-2">
      <div class="hidden md:block w-px h-10 bg-accent/30"></div>
      <div class="text-[10px] uppercase tracking-[0.2em] text-accent font-semibold whitespace-nowrap">conversione</div>
      <div class="text-accent text-2xl leading-none">→</div>
      <div class="hidden md:block w-px h-10 bg-accent/30"></div>
    </div>

    <div class="bg-white/[0.04] border border-accent/30 rounded-2xl p-6 flex flex-col gap-2">
      <div class="text-[11px] uppercase tracking-[0.18em] text-paper/55 font-medium">PROVIDER · MetaApi</div>
      <div class="text-lg font-semibold tracking-tight">short NAS100</div>
      <div class="flex items-baseline gap-2 mt-1">
        <span class="text-3xl font-semibold text-accent tabular-nums tracking-tight">1,46</span>
        <span class="text-sm text-paper/55 font-medium">lotti CFD</span>
      </div>
    </div>
  </div>

  <div class="px-4 py-1.5 bg-accent/10 border border-accent/30 rounded-full text-xs font-medium text-accent tracking-wide z-[2]">
    stato coordinato
  </div>
</div>

<style>
  /* Scroll-driven entrance: translateX/opacity are written every animation
     frame by scroll-driver.ts. No CSS transition (it would fight per-frame
     updates and feel laggy). */
  @keyframes hedge-fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hedge-center { animation: hedge-fade-in 0.6s ease-out 0.2s both; }
  @media (prefers-reduced-motion: reduce) {
    .hedge-center { animation: none; }
  }
</style>
