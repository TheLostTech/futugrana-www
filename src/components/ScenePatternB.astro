---
interface Props {
  bgClass: string;
  textClass?: string;
  titleClass?: string;
  eyebrow?: string;
  title?: string;
  wordTop: string;
  wordBottom: string;
  zIndex: number;
}
const {
  bgClass,
  textClass = "text-paper",
  titleClass = "text-ink",
  eyebrow,
  title,
  wordTop,
  wordBottom,
  zIndex,
} = Astro.props;
---
<section
  data-pattern-b
  class="relative h-[220vh] -mt-[100vh]"
  style={`z-index: ${zIndex};`}
>
  <div class:list={["sticky top-0 h-screen overflow-hidden flex items-center justify-center", bgClass]}>
    {eyebrow && (
      <p class:list={["absolute top-32 left-1/2 -translate-x-1/2 z-[6] text-xs uppercase tracking-[0.3em] font-semibold opacity-60", titleClass]}>
        {eyebrow}
      </p>
    )}

    {title && (
      <h2
        class:list={[
          "absolute top-[22%] left-1/2 -translate-x-1/2 z-[6]",
          "text-center leading-[1.05] tracking-[-0.01em] font-display font-medium",
          "text-[clamp(32px,5vw,80px)]",
          titleClass,
        ]}
        set:html={title}
      />
    )}

    <span
      class:list={[
        "absolute top-[14vh] left-[6vw] right-[6vw] z-[3] block text-left",
        "text-[clamp(50px,8.5vw,140px)] leading-[0.9] tracking-[-0.01em] font-display italic font-black lowercase",
        textClass,
      ]}
    >{wordTop}</span>

    <span
      class:list={[
        "absolute bottom-[7vh] left-[6vw] right-[6vw] z-[3] block text-right",
        "text-[clamp(50px,8.5vw,140px)] leading-[0.9] tracking-[-0.01em] font-display italic font-black lowercase",
        textClass,
      ]}
    >{wordBottom}</span>

    <div
      data-card-b
      class="absolute left-1/2 -translate-x-1/2 overflow-hidden will-change-transform shadow-[0_30px_60px_-20px_rgba(0,0,0,0.25)] z-[4]"
      style="width: 50vw; height: 55vh; bottom: -8%; border-radius: 24px;"
    >
      <slot />
    </div>
  </div>
</section>

<script>
  import "../scripts/scroll-driver";
</script>
