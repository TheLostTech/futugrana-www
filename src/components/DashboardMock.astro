---
const rows = [
  { name: "Lucid Trading", tags: ["FUT","TDV","MA"], phase: "funded", balance: "+$54.079", change: "+$1.453", status: "ready" },
  { name: "Alpha Futures", tags: ["FUT","TDV","MA"], phase: "funded", balance: "+$54.071", change: "+$1.567", status: "ready" },
  { name: "Topstep",       tags: ["FUT","TDV","MA"], phase: "funded", balance: "+$54.528", change: "+$1.686", status: "ready" },
  { name: "Apex",          tags: ["FUT","TDV","MA"], phase: "funded", balance: "+$99.995", change: "+$2.998", status: "running" },
];
---
<div class="w-full h-full bg-ink relative flex items-center justify-center p-[clamp(16px,2.6vw,48px)] overflow-hidden" style="perspective: 3200px;">
  <div
    class="dashboard-stage w-full max-w-[1180px] rounded-3xl border border-white/[0.08] bg-white/[0.015] text-paper overflow-hidden"
    style="transform: rotateX(2.5deg); transform-origin: center 80%; box-shadow: 0 50px 110px -32px rgba(0,0,0,0.7), 0 22px 50px -22px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.05);"
  >
    <div class="px-6 pt-5 pb-4 border-b border-white/[0.06] flex items-center justify-between gap-4 flex-wrap">
      <div class="flex items-center gap-3 min-w-0">
        <span class="text-paper/35 text-xs">▾</span>
        <span class="font-semibold tracking-tight text-paper text-[15px]">James Walker</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/[0.05] text-paper/55 border border-white/10 font-medium">4 challenge</span>
      </div>
      <div class="flex items-center gap-6 text-[11px]">
        <div class="flex items-baseline gap-1.5">
          <span class="text-paper/45 uppercase tracking-[0.15em] font-medium">Attive</span>
          <span class="font-mono text-paper tabular-nums">4</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-paper/45 uppercase tracking-[0.15em] font-medium">Concluse</span>
          <span class="font-mono text-paper/55 tabular-nums">0</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 p-5">
      <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5">
        <div class="text-[10px] uppercase tracking-[0.18em] text-paper/45 font-medium">Netto chiusura</div>
        <div class="text-[clamp(22px,2.4vw,32px)] font-semibold text-positive tabular-nums tracking-tight mt-1.5">$7.706,12</div>
        <div class="mt-3 pt-3 border-t border-white/[0.06] space-y-1 text-[11px]">
          <div class="flex justify-between">
            <span class="text-paper/55">Ideal chiusura attive</span>
            <span class="font-mono text-paper tabular-nums">$7.706,12</span>
          </div>
          <div class="flex justify-between">
            <span class="text-paper/55">Pagamenti in pending</span>
            <span class="font-mono text-paper/55 tabular-nums">$0,00</span>
          </div>
        </div>
      </div>
      <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-5">
        <div class="text-[10px] uppercase tracking-[0.18em] text-paper/45 font-medium">Prop Firm</div>
        <div class="text-[clamp(22px,2.4vw,32px)] font-semibold text-paper tabular-nums tracking-tight mt-1.5">−$1.500,00</div>
        <div class="mt-3 pt-3 border-t border-white/[0.06] space-y-1 text-[11px]">
          <div class="flex justify-between">
            <span class="text-paper/55">Costo iscrizioni</span>
            <span class="font-mono text-paper tabular-nums">−$1.500,00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-paper/55">Pagamenti incassati</span>
            <span class="font-mono text-paper/55 tabular-nums">$0,00</span>
          </div>
        </div>
      </div>
    </div>

    <div class="px-5 pt-2 pb-2 grid grid-cols-[1.6fr_0.7fr_1fr_1fr_0.8fr] gap-3 text-[9px] uppercase tracking-[0.18em] text-paper/35 font-medium">
      <div>Challenge</div>
      <div>Fase</div>
      <div class="text-right">Bilancio</div>
      <div class="text-right">Ideal ch.</div>
      <div class="text-right pr-1">Status</div>
    </div>

    <div class="px-5 pb-5 space-y-1.5">
      {rows.map((r) => (
        <div class="grid grid-cols-[1.6fr_0.7fr_1fr_1fr_0.8fr] gap-3 bg-white/[0.025] border border-white/[0.06] rounded-lg px-3 py-2.5 items-center">
          <div class="min-w-0">
            <div class="text-[12px] font-medium text-paper tracking-tight truncate">{r.name}</div>
            <div class="flex gap-1 mt-1">
              {r.tags.map((tag) => (
                <span class="text-[8px] font-mono text-paper/50 px-1.5 py-0.5 rounded bg-white/[0.04] border border-white/[0.08] tracking-wide">{tag}</span>
              ))}
            </div>
          </div>
          <div class="flex">
            <span class="text-[9px] uppercase tracking-[0.15em] px-2 py-0.5 rounded-full bg-accent/10 text-accent border border-accent/30 font-medium">{r.phase}</span>
          </div>
          <div class="text-right text-[12px] font-mono text-paper tabular-nums">{r.balance}</div>
          <div class="text-right text-[12px] font-mono text-accent tabular-nums">{r.change}</div>
          <div class="flex justify-end">
            <span class:list={[
              "text-[9px] uppercase tracking-[0.15em] px-2 py-0.5 rounded-full border font-medium",
              r.status === "running"
                ? "bg-white/[0.05] text-paper/55 border-white/15"
                : "bg-positive/10 text-positive border-positive/30",
            ]}>{r.status}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="px-6 py-3 border-t border-white/[0.06] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-paper/35 text-xs">▸</span>
        <span class="font-semibold tracking-tight text-paper/70 text-[14px]">Sarah Mitchell</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/[0.04] text-paper/45 border border-white/10 font-medium">3 challenge</span>
      </div>
      <div class="text-[11px] text-paper/45">
        Netto <span class="font-mono text-paper/70 tabular-nums">+$1.028,37</span>
      </div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .dashboard-stage {
      transform: none !important;
    }
  }
</style>
