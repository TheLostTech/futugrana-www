---
import ScenePatternA from "./ScenePatternA.astro";
import DashboardMock from "./DashboardMock.astro";
import { localizeUrl, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const appUrl = "https://app.futugrana.com";

const t = locale === "it"
  ? {
      toggleTrader: "Trader",
      toggleManager: "Gestore",
      title: "Una piattaforma operativa<br>per gestire le tue prop firm.",
      sub: "Traccia acquisti, fasi, costi e payout. Quando serve, operi dalla dashboard e coordini la copertura broker. Le decisioni restano sempre al trader.",
      ctaPrimary: "Inizia gratis →",
      ctaMicro: "Nessuna carta richiesta. Parti dal gestionale, aggiorni quando ti serve operare.",
      ctaSecondary: "Scopri la piattaforma",
      chips: ["Gestionale", "Console operativa", "Copertura broker", "Registro", "Multi-provider"],
      wordLeft: "piattaforma",
      wordRight: "operativa",
    }
  : {
      toggleTrader: "Trader",
      toggleManager: "Manager",
      title: "An operational platform<br>to manage your prop firms.",
      sub: "Track purchases, phases, costs and payouts. When you need to, operate from the dashboard and coordinate broker coverage. Decisions always stay with the trader.",
      ctaPrimary: "Start free →",
      ctaMicro: "No card required. Start with the management tools, upgrade when you need to operate.",
      ctaSecondary: "Explore the platform",
      chips: ["Management", "Operational console", "Broker coverage", "Record", "Multi-provider"],
      wordLeft: "operational",
      wordRight: "platform",
    };
---
<script is:inline>
  // Must run before the hero paints: see the note in ScenePatternA.astro.
  // Keep the media query in sync with HERO_SEQ_QUERY in hero-sequence.ts.
  (function () {
    var q = "(min-width: 900px) and (min-aspect-ratio: 5/4) and (prefers-reduced-motion: no-preference)";
    if (!window.matchMedia(q).matches || window.scrollY > 10) return;
    var root = document.documentElement;
    root.classList.add("hero-seq-pending");
    setTimeout(function () { root.classList.remove("hero-seq-pending"); }, 2500);
  })();
</script>

<ScenePatternA
  bgClass="bg-celeste"
  textClass="text-ink"
  wordsClass="text-ink/[0.04]"
  eyebrow=""
  title=""
  wordLeft={t.wordLeft}
  wordRight={t.wordRight}
  zIndex={10}
  hero
>
  <DashboardMock />
</ScenePatternA>

<div class="fixed top-[88px] left-1/2 -translate-x-1/2 z-[20] pointer-events-none" data-hero-overlay data-hero-fade>
  <div class="bg-ink text-paper rounded-full p-1.5 inline-flex gap-0 text-sm font-medium pointer-events-auto">
    <span class="px-5 py-2 rounded-full bg-paper text-ink">{t.toggleTrader}</span>
    <a href={localizeUrl("/per-gestori", locale)} class="px-5 py-2 rounded-full hover:bg-white/10">{t.toggleManager}</a>
  </div>
</div>

<div class="fixed inset-x-0 top-[20vh] z-[20] pointer-events-none px-[clamp(28px,6vw,100px)]" data-hero-cta data-hero-fade>
  <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-6 items-start">
    <h1
      class="md:col-span-7 font-display font-medium text-[clamp(38px,5vw,78px)] tracking-[-0.01em] leading-[1.05] text-ink pointer-events-auto"
      set:html={t.title}
    />
    <div class="md:col-span-5 md:pt-[7vh] flex flex-col gap-5 pointer-events-auto max-w-[440px]">
      <p class="text-[15px] text-ink/70 leading-relaxed" set:html={t.sub} />
      <div class="flex flex-col items-start gap-3">
        <a href={`${appUrl}/signup?ref=hero`} class="inline-block px-7 py-3.5 bg-ink text-paper rounded-full font-semibold text-sm tracking-tight hover:opacity-90 transition-opacity">
          {t.ctaPrimary}
        </a>
        <p class="text-[12px] text-ink/55 leading-snug">{t.ctaMicro}</p>
        <a href={localizeUrl("/prezzi", locale)} class="text-sm text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent transition-colors">{t.ctaSecondary}</a>
      </div>
      <ul class="flex flex-wrap gap-2 pt-1">
        {t.chips.map((chip) => (
          <li class="px-3 py-1.5 rounded-full border border-ink/15 text-[12px] font-medium text-ink/70">{chip}</li>
        ))}
      </ul>
    </div>
  </div>
</div>
