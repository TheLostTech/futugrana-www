---
import { localizeUrl, type Locale } from "../lib/i18n";
import FlowConnectMock from "./FlowConnectMock.astro";
import FlowConfigureMock from "./FlowConfigureMock.astro";
import FlowActivateMock from "./FlowActivateMock.astro";
import FlowTrackMock from "./FlowTrackMock.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const appUrl = "https://app.futugrana.com";

const t = locale === "it"
  ? {
      cta: "Inizia gratis →",
      ctaSub: "Nessuna carta richiesta. Parti dal gestionale, aggiorni quando ti serve operare.",
      steps: [
        { title: "Connetti",  desc: "Colleghi i tuoi provider in pochi minuti. Tradovate via OAuth, MetaApi via token. Credenziali gestite in modo sicuro.", visual: { meta: "step 1 — onboarding", title: "Collega il provider", icon: "🔗" } },
        { title: "Configura", desc: "Registri gli account che vuoi gestire e coordinare, su tutti i provider. Acquisti, fasi e costi sempre in ordine.", visual: { meta: "step 2 — setup", title: "Registra l'account", icon: "📥" } },
        { title: "Opera",     desc: "Quando lo decidi tu, operi dalla dashboard e coordini la copertura broker. Solo su tuo comando, nessuna decisione automatica.", visual: { meta: "step 3 — go-live", title: "Opera dalla dashboard", icon: "⚡" } },
        { title: "Traccia",   desc: "Movimenti e registri operativi consultabili dalla dashboard. Il tuo registro contabile sempre allineato.", visual: { meta: "step 4 — registro", title: "Registro allineato", icon: "📊" } },
      ],
    }
  : {
      cta: "Start free →",
      ctaSub: "No card required. Start with the management tools, upgrade when you need to operate.",
      steps: [
        { title: "Connect",   desc: "Connect your providers in minutes. Tradovate via OAuth, MetaApi via token. Credentials handled securely.", visual: { meta: "step 1 — onboarding", title: "Connect the provider", icon: "🔗" } },
        { title: "Configure", desc: "Register the accounts you want to manage and coordinate, across every provider. Purchases, phases and costs always in order.", visual: { meta: "step 2 — setup", title: "Register account", icon: "📥" } },
        { title: "Operate",   desc: "When you decide, operate from the dashboard and coordinate broker coverage. On your command only, no automated decisions.", visual: { meta: "step 3 — go-live", title: "Operate from the dashboard", icon: "⚡" } },
        { title: "Track",     desc: "Operational records and movements available from the dashboard. Your bookkeeping always in sync.", visual: { meta: "step 4 — record", title: "Records in sync", icon: "📊" } },
      ],
    };
---
<section data-flow class="relative h-[320vh] bg-blu" style="z-index: 15;">
  <div class="sticky top-0 h-screen text-paper grid grid-cols-1 md:grid-cols-2 items-center px-[clamp(40px,8vw,140px)] gap-15">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-3.5">
        {t.steps.map((s, i) => (
          <span
            data-flow-title
            data-active={i === 0 ? "true" : "false"}
            class="font-display font-medium text-[clamp(24px,3.5vw,50px)] leading-[1.05] tracking-[-0.01em] text-center transition-colors duration-500 data-[active=true]:text-paper data-[active=false]:text-paper/[0.22]"
          >{s.title}</span>
        ))}
      </div>
      <div class="min-h-[100px] max-w-[460px]">
        {t.steps.map((s, i) => (
          <p data-flow-desc class="text-lg leading-snug font-medium opacity-90 mb-7" style={i === 0 ? "display:block" : "display:none"}>{s.desc}</p>
        ))}
        <div class="flex flex-col items-start gap-3">
          <a href={`${appUrl}/signup?ref=flow`} class="inline-block px-7 py-3.5 bg-paper text-ink rounded-full font-semibold text-sm tracking-tight hover:bg-paper/90 transition-colors">
            {t.cta}
          </a>
          <p class="text-[13px] text-paper/65 leading-snug max-w-[420px]">{t.ctaSub}</p>
        </div>
      </div>
    </div>

    <div class="relative h-[75vh] rounded-3xl overflow-hidden bg-black/20">
      {t.steps.map((s, i) => (
        <div
          data-flow-slide
          data-position={i === 0 ? "active" : "next"}
          class="absolute inset-0 flex items-center justify-center p-[6%] transition-[transform,opacity] duration-700 ease-[cubic-bezier(0.65,0,0.25,1)] opacity-0
                 data-[position=active]:opacity-100 data-[position=active]:translate-y-0
                 data-[position=next]:translate-y-full
                 data-[position=prev]:-translate-y-full"
        >
          <div class="w-full h-full bg-paper rounded-2xl p-6 md:p-7 text-ink flex flex-col gap-4">
            <div class="flex items-center justify-between">
              <span class="text-[11px] uppercase tracking-[0.18em] text-muted font-medium">{s.visual.meta}</span>
            </div>
            <h4 class="text-xl font-semibold tracking-tight leading-tight">{s.visual.title}</h4>
            {i === 0 ? (
              <FlowConnectMock />
            ) : i === 1 ? (
              <FlowConfigureMock />
            ) : i === 2 ? (
              <FlowActivateMock />
            ) : (
              <FlowTrackMock />
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
