---
interface Props {
  bgClass: string;
  textClass?: string;
  wordsClass?: string;
  eyebrow: string;
  title: string;
  wordLeft: string;
  wordRight: string;
  zIndex: number;
  /** Hero scene: drives the headline overlay and the Blender sequence. */
  hero?: boolean;
}
const {
  bgClass,
  textClass = "text-ink",
  wordsClass = "text-paper",
  eyebrow,
  title,
  wordLeft,
  wordRight,
  zIndex,
  hero = false,
} = Astro.props;
---
<section
  data-pattern-a
  data-hero={hero ? "" : undefined}
  class="relative h-[220vh]"
  style={`z-index: ${zIndex};`}
>
  <div class:list={["sticky top-0 h-screen overflow-hidden flex items-center justify-center", bgClass]}>
    <p class:list={["absolute top-32 left-1/2 -translate-x-1/2 text-xs uppercase tracking-[0.3em] font-semibold opacity-50", textClass]}>
      {eyebrow}
    </p>

    <h2
      data-title
      class:list={[
        "absolute top-[38%] left-1/2 -translate-x-1/2 -translate-y-1/2",
        "text-center leading-[1.05] tracking-[-0.01em] font-display font-medium",
        "text-[clamp(32px,5vw,80px)]",
        textClass,
      ]}
      set:html={title}
    />

    <span
      data-word-left
      class:list={[
        "absolute top-[14vh] left-0 right-0 text-center block",
        "text-[clamp(50px,8.5vw,140px)] leading-[0.9] tracking-[-0.01em] font-display italic font-black lowercase",
        "opacity-0 pointer-events-none z-[4]",
        wordsClass,
      ]}
    >{wordLeft}</span>

    <span
      data-word-right
      class:list={[
        "absolute bottom-[7vh] left-0 right-0 text-center block",
        "text-[clamp(50px,8.5vw,140px)] leading-[0.9] tracking-[-0.01em] font-display italic font-black lowercase",
        "opacity-0 pointer-events-none z-[4]",
        wordsClass,
      ]}
    >{wordRight}</span>

    <!-- Full-viewport card that grows with transform: scale() (no reflow, the
         content enlarges as one object). Initial style = state at scroll 0,
         so the first paint matches before the script runs. -->
    <div
      data-card
      class="absolute inset-x-0 bottom-0 h-full overflow-hidden bg-ink origin-bottom z-[3] will-change-transform shadow-[0_60px_120px_-40px_rgba(0,0,0,0.30)] data-[sequence=true]:shadow-none"
      style="transform: translate3d(0, 8vh, 0) scale(0.5); border-radius: 48px; --tilt: 10deg;"
    >
      <div data-card-inner class="w-full h-full">
        <slot />
      </div>
    </div>

    {hero && (
      <canvas
        data-hero-canvas
        aria-hidden="true"
        class="absolute inset-0 w-full h-full z-[3] pointer-events-none"
        style="visibility: hidden;"
      ></canvas>
    )}
  </div>
</section>

<script>
  import "../scripts/scroll-driver";
</script>

<style is:global>
  /* While the Blender hero loads (wide screens, top of the page) the card and
     the display stay hidden, then fade in: no flat-card-to-3D jump. Set by
     the inline script in Hero.astro, removed by hero-sequence.ts (or by a
     timeout, so the card can never stay hidden). */
  [data-hero] [data-card],
  [data-hero] canvas {
    transition: opacity 0.7s ease;
  }
  html.hero-seq-pending [data-hero] [data-card],
  html.hero-seq-pending [data-hero] canvas {
    opacity: 0;
  }
</style>
