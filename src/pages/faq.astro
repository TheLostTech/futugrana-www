---
import PageLayout from "../layouts/PageLayout.astro";

const categories = [
  { title: "Prezzi & prova", questions: [
    { q: "Quanto costa iniziare?", a: "Niente: il gestionale è gratis. Paghi solo quando attivi operatività o copertura, oppure la fee una tantum di Funded Activation quando un account passa funded." },
    { q: "Posso cambiare o disdire il piano?", a: "Sì, in qualsiasi momento dalla dashboard. Nessun vincolo di durata." },
  ]},
  { title: "Setup tecnico", questions: [
    { q: "Posso collegare più provider?", a: "Sì. Tradovate, MetaApi (MT4/MT5) e ProjectX, anche tutti insieme. Ogni connessione è isolata." },
    { q: "Serve installare qualcosa?", a: "No. Futugrana è una web app: colleghi gli account e operi dalla dashboard." },
  ]},
  { title: "Operatività & copertura", questions: [
    { q: "Futugrana fa trading al posto mio?", a: "No, mai. La piattaforma esegue solo comandi espliciti che invii tu, li collega alla contabilità e coordina gli ambienti. Nessuna decisione automatica, nessun segnale, nessuna gestione del capitale." },
    { q: "Cos'è la copertura broker/slave?", a: "Nel piano Eval Coverage, la piattaforma coordina la gamba prop e la gamba broker/slave secondo i parametri che imposti tu, per allineare le posizioni tra ambienti." },
  ]},
  { title: "Account funded", questions: [
    { q: "Cosa succede quando un account passa funded?", a: "La piattaforma rileva il nuovo account ID e attiva la gestione sullo slot corrispondente. L'attivazione funded è una fee una tantum legata a quell'account: 25K $5, 50K $10, 100K e oltre $15." },
  ]},
  { title: "Dati & supporto", questions: [
    { q: "I miei dati sono al sicuro?", a: "Le connessioni ai provider sono isolate e cifrate. Vedi l'Informativa Privacy per i dettagli sul trattamento." },
    { q: "Come posso contattarvi?", a: "Email a support@futugrana.com o tramite la community ufficiale su Telegram." },
  ]},
];
---
<PageLayout title="FAQ" description="Domande frequenti su futugrana." locale="it">
  <section class="bg-paper px-8 pt-32 pb-24">
    <div class="max-w-[800px] mx-auto">
      <h1 class="text-[clamp(28px,4vw,64px)] font-display font-medium tracking-[-0.01em] leading-[1.05] mb-16 text-center">FAQ.</h1>
      {categories.map((cat) => (
        <div class="mb-12">
          <h2 class="text-xs uppercase tracking-[0.3em] text-ink/50 mb-6 font-semibold">{cat.title}</h2>
          <div class="space-y-3">
            {cat.questions.map((f) => (
              <details class="bg-ink/[0.03] rounded-2xl p-6 group">
                <summary class="font-bold text-lg list-none flex justify-between items-center cursor-pointer">
                  <span>{f.q}</span>
                  <span class="text-2xl group-open:rotate-45 transition-transform">+</span>
                </summary>
                <p class="text-base opacity-80 mt-4 font-medium leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
      <p class="text-base text-ink/50 italic mt-12">
        Non trovi la risposta? Scrivi a <a href="mailto:support@futugrana.com" class="underline">support@futugrana.com</a>.
      </p>
    </div>
  </section>
</PageLayout>
