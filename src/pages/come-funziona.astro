---
import PageLayout from "../layouts/PageLayout.astro";

const steps = [
  { n: "01", t: "Connetti", d: "Colleghi le tue prop firm e, se previsto dal piano, i provider di esecuzione (Tradovate, MetaApi, ProjectX). Ogni connessione è isolata e indipendente.", note: "Sola lettura finché non abiliti l'operatività." },
  { n: "02", t: "Configura", d: "Registri acquisti, fasi, costi di iscrizione e regole operative. La piattaforma costruisce la base contabile di ogni account.", note: "Nessun parametro decide per te: imposti tu." },
  { n: "03", t: "Opera", d: "Nei piani superiori invii comandi espliciti dalla dashboard sulla gamba prop, ed eventualmente coordini la copertura broker/slave secondo i tuoi parametri.", note: "Comando esplicito. Nessuna decisione automatica, nessun segnale." },
  { n: "04", t: "Traccia", d: "Operazioni, costi, fee, payout e versamenti finiscono nello stesso registro operativo, pronto per la riconciliazione e il commercialista.", note: "Un'unica fonte di verità, sempre allineata." },
];
---
<PageLayout title="Come funziona" description="Dalla gestione prop firm all'esecuzione controllata, in quattro passaggi." locale="it">
  <section class="bg-paper px-8 pt-32 pb-14 text-center">
    <div class="max-w-[820px] mx-auto">
      <p class="text-xs uppercase tracking-[0.3em] text-muted mb-[18px]">Come funziona</p>
      <h1 class="font-display font-medium tracking-[-0.01em] leading-[1.05] text-[clamp(34px,4.4vw,60px)] text-ink m-0">
        Dalla gestione prop firm<br>all'esecuzione controllata.
      </h1>
      <p class="text-[19px] leading-[1.55] text-ink/70 max-w-[640px] mx-auto mt-[22px]">
        Quattro passaggi, un'unica applicazione. Parti dal gestionale e attivi operatività e copertura solo quando ti servono. Il controllo resta sempre al trader.
      </p>
    </div>
  </section>

  <section class="bg-paper px-8 pt-6 pb-24">
    <div class="max-w-[940px] mx-auto flex flex-col gap-4">
      {steps.map((s, i) => (
        <div class="grid grid-cols-[64px_1fr] md:grid-cols-[84px_1fr] gap-6 items-start bg-surface border border-border rounded-[18px] px-[30px] py-7">
          <div class:list={["font-display leading-none text-[40px]", i < 2 ? "text-positive-hover" : "text-accent"]}>{s.n}</div>
          <div>
            <h3 class="font-semibold tracking-tight text-[22px] m-0 mb-2 text-ink">{s.t}</h3>
            <p class="text-base leading-[1.55] text-ink/70 m-0 mb-3">{s.d}</p>
            <div class="inline-flex items-center gap-2 text-[13px] font-semibold text-muted bg-paper border border-border rounded-full px-3 py-[5px]">
              <span class="text-positive">✓</span>{s.note}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink text-paper px-8 py-[72px] text-center">
    <div class="max-w-[680px] mx-auto">
      <h2 class="font-display font-medium tracking-[-0.01em] leading-[1.05] text-[32px] text-paper m-0 mb-[18px]">Il trader decide, Futugrana coordina.</h2>
      <p class="text-base leading-[1.6] text-paper/70 m-0">
        Futugrana fornisce strumenti software di gestione e coordinamento operativo. Non fornisce consulenza finanziaria, segnali di trading o gestione del capitale. Ogni comando parte da una tua azione esplicita.
      </p>
    </div>
  </section>
</PageLayout>
