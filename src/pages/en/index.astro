---
import PageLayout from "../../layouts/PageLayout.astro";
import Hero from "../../components/Hero.astro";
import ScenePatternA from "../../components/ScenePatternA.astro";
import HedgeMock from "../../components/HedgeMock.astro";
import KpiLogMock from "../../components/KpiLogMock.astro";
import MultiBrokerMock from "../../components/MultiBrokerMock.astro";
import LedgerMock from "../../components/LedgerMock.astro";
import FlowSection from "../../components/FlowSection.astro";
import PricingCards from "../../components/PricingCards.astro";
import TrustRow from "../../components/TrustRow.astro";
import PreFooterCTA from "../../components/PreFooterCTA.astro";
---
<PageLayout title="futugrana" locale="en">
  <Hero locale="en" />
  <ScenePatternA bgClass="bg-verde-menta" wordsClass="text-ink/[0.04]" eyebrow="01 — operational console" title="Operate from the dashboard,<br>when you decide." wordLeft="explicit" wordRight="commands" zIndex={11}>
    <KpiLogMock />
  </ScenePatternA>
  <ScenePatternA bgClass="bg-giallo" wordsClass="text-ink/[0.04]" eyebrow="02 — coverage" title="Broker coverage,<br>only when you enable it." wordLeft="coverage" wordRight="coordinated" zIndex={12}>
    <HedgeMock />
  </ScenePatternA>
  <ScenePatternA bgClass="bg-viola" wordsClass="text-ink/[0.05]" eyebrow="03 — multi-provider" title="Tradovate.<br>MetaApi. ProjectX." wordLeft="providers" wordRight="connected" zIndex={13}>
    <MultiBrokerMock />
  </ScenePatternA>
  <ScenePatternA bgClass="bg-celeste-2" textClass="text-paper" wordsClass="text-paper/[0.06]" eyebrow="04 — record" title="Every movement<br>stays on the record." wordLeft="movements" wordRight="tracked" zIndex={14}>
    <LedgerMock />
  </ScenePatternA>
  <FlowSection locale="en" />
  <PricingCards locale="en" />
  <TrustRow locale="en" />
  <PreFooterCTA locale="en" />
</PageLayout>
