---
import PageLayout from "../../layouts/PageLayout.astro";
import PricingCards from "../../components/PricingCards.astro";
import EnPlaceholderBanner from "../../components/EnPlaceholderBanner.astro";

const faqs = [
  { q: "How much does it cost to start?", a: "The Free plan is free for basic management and tracking. Monthly plans start at €9,90 and unlock unlimited management; higher tiers add operating from the dashboard and broker coverage." },
  { q: "Can I switch plans?", a: "Yes, anytime from the dashboard. Move from Management to Operate Prop or Eval Coverage when you need to operate or hedge." },
  { q: "What is funded activation?", a: "When an account goes funded, there's a one-time fee tied to that account: 25K $5, 50K $10, 100K and above $15. It is not a subscription." },
  { q: "Which payment methods do you accept?", a: "Credit card (Stripe) and SEPA." },
  { q: "Can I try it without commitment?", a: "Yes. The Free plan always stays free for basic management and tracking — use it as long as you want before moving to a monthly plan." },
];
---
<PageLayout title="Pricing" description="A free plan, three monthly plans and one-time funded activation." locale="en">
  <EnPlaceholderBanner />
  <section class="bg-paper px-8 pt-32 pb-12">
    <div class="max-w-[1200px] mx-auto text-center">
      <h1 class="text-[clamp(28px,4vw,64px)] font-display font-medium tracking-[-0.01em] leading-[1.05] mb-6">Pricing.</h1>
      <p class="text-xl text-ink/60 max-w-2xl mx-auto font-medium">
        Start free with the management tools. Monthly plans unlock unlimited management, operations and coverage. Funded activation is a one-time fee.
      </p>
    </div>
  </section>

  <PricingCards locale="en" />

  <section class="bg-paper px-8 py-24">
    <div class="max-w-[760px] mx-auto">
      <h2 class="text-[clamp(20px,2.5vw,36px)] font-display font-medium tracking-[-0.01em] leading-[1.05] mb-12 text-center">
        Frequently asked questions.
      </h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="bg-ink/[0.03] rounded-2xl p-6 cursor-pointer group">
            <summary class="font-bold text-lg list-none flex justify-between items-center">
              <span>{f.q}</span>
              <span class="text-2xl group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-base opacity-80 mt-4 font-medium leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
