---
import PageLayout from "../../layouts/PageLayout.astro";
import LegalDoc, { type LegalSection } from "../../components/LegalDoc.astro";

const sections: LegalSection[] = [
  { h: "Data controller", p: ["The data controller is Futugrana (“Futugrana” or “we”). For any request regarding personal data you can write to <strong>privacy@futugrana.com</strong>."] },
  { h: "Data we collect", list: [
    "<strong>Account data:</strong> name, email, credentials, language and preferences.",
    "<strong>Operational data:</strong> connected prop firms and accounts, purchases, phases, costs, payouts, movements and the commands you explicitly send from the dashboard.",
    "<strong>Provider connection data:</strong> tokens and account identifiers at Tradovate, MetaApi, ProjectX and connected brokers, stored encrypted.",
    "<strong>Technical data:</strong> access logs, IP address, device and browser type.",
  ]},
  { h: "Purposes and legal bases", p: ["We process data to provide the service (performance of the contract), to comply with legal obligations (e.g. accounting and tax), for security and abuse prevention (legitimate interest) and, subject to consent, for marketing communications."] },
  { h: "What we do NOT do", p: ["Futugrana is an operational management and coordination software tool. <strong>We do not make investment decisions, do not execute operations autonomously, do not manage your capital and do not provide signals or financial advice.</strong> Every command starts from an explicit action of yours."] },
  { h: "Retention", p: ["We keep data for as long as necessary for the purposes described and, where required, for statutory periods (e.g. ten years for accounting records). When the account is closed, data no longer needed is deleted or anonymised."] },
  { h: "Sharing with third parties", list: [
    "Infrastructure and hosting providers, under a data processing agreement (DPA).",
    "Payment providers (e.g. Stripe) for subscription management.",
    "Execution providers and brokers that <em>you</em> connect, limited to what is necessary for coordination.",
  ]},
  { h: "Transfers outside the EU", p: ["Any transfers outside the European Economic Area take place only to providers that guarantee adequate safeguards (e.g. Standard Contractual Clauses)."] },
  { h: "Your rights", p: ["You have the right of access, rectification, erasure, restriction, portability and objection, as well as the right to lodge a complaint with the supervisory authority. To exercise them write to <strong>privacy@futugrana.com</strong>."] },
  { h: "Security", p: ["We adopt appropriate technical and organisational measures: encryption of provider tokens, access control and isolation of connections for each account."] },
  { h: "Changes", p: ["We may update this policy. The version in force is always published on this page with the last-updated date."] },
];
---
<PageLayout title="Privacy Policy" description="How Futugrana processes personal data, under the GDPR." locale="en">
  <LegalDoc
    title="Privacy Policy"
    updated="1 June 2026"
    intro="This policy describes how Futugrana processes the personal data of platform and website users, pursuant to Regulation (EU) 2016/679 (GDPR)."
    sections={sections}
    locale="en"
  />
</PageLayout>
